# Copia este archivo a despliegue/.env y rellénalo. despliegue/.env NUNCA se sube al repositorio.

# ---------------------------------------------------------------- base de datos
POSTGRES_USER=midiabetes
POSTGRES_DB=midiabetes
POSTGRES_PASSWORD=cambia-esto-por-una-contraseña-larga
# Puerto solo en 127.0.0.1 del PC (para pgAdmin o psql). No se expone fuera.
PUERTO_BD_LOCAL=5432

# ---------------------------------------------------------------- Nightscout (SOLO LECTURA)
# Nightscout → Admin Tools → Subjects → nuevo sujeto con rol "readable" → copia su token.
# URL interna vista desde Docker. Si Nightscout corre en el mismo Docker, usa el nombre del
# contenedor (p. ej. http://nightscout:1337); si corre en el PC, http://host.docker.internal:1337
NIGHTSCOUT_URL=http://host.docker.internal:1337
NIGHTSCOUT_TOKEN=
INTERVALO_RECOLECCION_S=300
SOLAPE_INCREMENTAL_MIN=180
HUECO_MIN=20

# ---------------------------------------------------------------- app y passkey
# RP_ID es el dominio donde se abre la app; las passkeys quedan atadas a él.
RP_ID=midiabetes.intelligentcontrol.net
ORIGENES=https://midiabetes.intelligentcontrol.net
# Código para dar de alta la primera passkey. Pon uno largo y bórralo cuando tengas tus passkeys.
CODIGO_ALTA=
COOKIE_SEGURA=1
DIAS_SESION=30
PUERTO_API_LOCAL=8000

# ---------------------------------------------------------------- rangos
RANGO_BAJO=70
RANGO_ALTO=180
ZONA_HORARIA=Europe/Madrid

# ---------------------------------------------------------------- Cloudflare Tunnel
# Token del túnel (Zero Trust → Networks → Tunnels → tu túnel → Install connector).
CLOUDFLARE_TUNNEL_TOKEN=
