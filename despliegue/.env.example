# Copia este archivo a despliegue/.env y rellénalo. despliegue/.env NUNCA se sube al repositorio.

# ---------------------------------------------------------------- base de datos
POSTGRES_USER=midiabetes
POSTGRES_DB=midiabetes
POSTGRES_PASSWORD=cambia-esto-por-una-contraseña-larga
# Puerto solo en 127.0.0.1 del PC (para pgAdmin o psql). No se expone fuera.
PUERTO_BD_LOCAL=5432

# ---------------------------------------------------------------- Nightscout (SOLO LECTURA)
# Nightscout → Admin Tools → Subjects → nuevo sujeto con rol "readable" → copia su token.
# URL interna vista desde Docker. Si Nightscout corre en el mismo Docker, usa el nombre del
# contenedor (p. ej. http://nightscout:1337); si corre en el PC, http://host.docker.internal:1337
NIGHTSCOUT_URL=http://host.docker.internal:1337
NIGHTSCOUT_TOKEN=
INTERVALO_RECOLECCION_S=300
SOLAPE_INCREMENTAL_MIN=180
HUECO_MIN=20

# ---------------------------------------------------------------- Nightscout (ESCRITURA, solo la pluma)
# Sujeto aparte con rol "careportal" (puede crear tratamientos). Solo lo usa el recolector de la
# pluma para escribir sus dosis con enteredBy "mi-diabetes/libreview". Vacío = no escribe.
NIGHTSCOUT_TOKEN_ESCRITURA=

# ---------------------------------------------------------------- LibreView (API no oficial)
# Tu cuenta de LibreView (la de la app FreeStyle Libre del iPhone, la que recibe la pluma).
LIBREVIEW_EMAIL=
LIBREVIEW_PASSWORD=
# Vacío = la región que diga LibreView al entrar (para España suele ser "eu").
LIBREVIEW_REGION=
# Versión de la web de LibreView que se anuncia (cámbiala solo si LibreView deja de responder).
LIBREVIEW_VERSION=3.27.0.42
# Dónde guarda el recolector el "dispositivo de confianza" que da LibreView tras el SMS
# (dentro del volumen sesion-libreview; nunca en el repositorio).
LIBREVIEW_SESION=/datos/libreview/sesion.json
# LibreView no deja pedir el SMS desde el recolector. Haz el doble factor en Chrome marcando
# "recordar este dispositivo" y copia aquí su token (consola de Chrome en libreview.com:
#   Object.values(JSON.parse(localStorage.trustedDeviceTokens))[0]
# ). Es un secreto: solo aquí. Caduca a las ~2 semanas; entonces se repite.
LIBREVIEW_DISPOSITIVO_CONFIANZA=
# LibreView solo se lee cuando se pide (botón de la app o, en la fase 3, al calcular una dosis).
# Cada cuánto mira la base el recolector para ver si hay una lectura pedida, un SMS o un código.
INTERVALO_PLUMA_S=5
SOLAPE_PLUMA_H=48

# ---------------------------------------------------------------- aviso "Lee la pluma"
# Avisa en el panel si no llega ninguna dosis de la pluma en estas horas, o si una dosis
# apuntada en la app sigue sin llegar de la pluma pasados estos minutos.
AVISO_PLUMA_HORAS=12
AVISO_PLUMA_MARGEN_MIN=45

# ---------------------------------------------------------------- app y passkey
# RP_ID es el dominio donde se abre la app; las passkeys quedan atadas a él.
RP_ID=midiabetes.intelligentcontrol.net
ORIGENES=https://midiabetes.intelligentcontrol.net
# Código para dar de alta la primera passkey. Pon uno largo y bórralo cuando tengas tus passkeys.
CODIGO_ALTA=
COOKIE_SEGURA=1
DIAS_SESION=30
PUERTO_API_LOCAL=8000

# ---------------------------------------------------------------- rangos
RANGO_BAJO=70
RANGO_ALTO=180
ZONA_HORARIA=Europe/Madrid

# ---------------------------------------------------------------- Cloudflare Tunnel
# Token del túnel (Zero Trust → Networks → Tunnels → tu túnel → Install connector).
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------- comidas por foto (Ollama nativo)
# Ollama corre en Windows con la GPU. Desde Docker se llega por host.docker.internal.
OLLAMA_URL=http://host.docker.internal:11434
# Vacío = los modelos de servicios/comidas/config.py (qwen3-vl:32b, gemma3:27b, minicpm-v),
# una ronda por modelo (2 como máximo, la segunda solo si discrepan) y contexto de 8192 tokens.
COMIDAS_MODELOS=
COMIDAS_RONDAS_MAX=
COMIDAS_CONTEXTO=

# ---------------------------------------------------------------- anomalías y avisos (fase 4)
# Servidor ntfy de casa (contenedor `ntfy`). Pasos en despliegue/ntfy/README.md.
# Vacío = las anomalías se ven solo en la app (pantalla Avisos).
NTFY_URL=http://ntfy:80
# Tema largo y aleatorio, y token de escritura del usuario "midiabetes". Secretos: solo aquí.
NTFY_TEMA=
NTFY_TOKEN=
# Se abre al tocar el aviso.
URL_APP=https://midiabetes.intelligentcontrol.net
INTERVALO_ANOMALIAS_S=300
# Umbrales (los de por defecto, aprobados por Daniel el 20-11-2026). Lista completa:
#   docker compose exec anomalias python -m servicios.anomalias umbrales
# Cualquiera se cambia con ANOMALIA_<NOMBRE>, p. ej.:
# ANOMALIA_HUECO_MIN=30
# ANOMALIA_MAX_AVISOS_DIA=6
# ANOMALIA_SILENCIO_DESDE=23:00
# ANOMALIA_SILENCIO_HASTA=08:00
# Tipos que no se detectan (coma): hueco, presion, subida_sin_comida, dosis_sin_comida, acumulacion, olvido_tresiba
# ANOMALIA_DESACTIVADAS=
